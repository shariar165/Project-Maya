{
  "name": "Maya — Missed Appointment",
  "nodes": [
    {
      "name": "Schedule — Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 1 }] }
      },
      "position": [200, 300]
    },
    {
      "name": "Check Maya API Health",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "http://localhost:8000/n8n/health"
      },
      "position": [420, 300]
    },
    {
      "name": "Log Check",
      "type": "n8n-nodes-base.code",
      "parameters": {
        "jsCode": "// In production: query /missed-appointments endpoint and escalate\nconsole.log('[n8n] Missed appointment check at ' + new Date().toISOString());\nreturn items;"
      },
      "position": [640, 300]
    }
  ],
  "connections": {
    "Schedule — Every Hour": { "main": [[{ "node": "Check Maya API Health" }]] },
    "Check Maya API Health": { "main": [[{ "node": "Log Check" }]] }
  }
}
