{
  "name": "Maya — Document Ingestion",
  "nodes": [
    {
      "name": "Webhook — PDF Upload",
      "type": "n8n-nodes-base.webhook",
      "parameters": {
        "path": "maya-ingest-document",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": { "binaryData": true }
      },
      "position": [200, 300]
    },
    {
      "name": "Validate File Type",
      "type": "n8n-nodes-base.if",
      "parameters": {
        "conditions": {
          "string": [{
            "value1": "={{$json.headers['content-type']}}",
            "operation": "contains",
            "value2": "pdf"
          }]
        }
      },
      "position": [420, 300]
    },
    {
      "name": "Save PDF to docs/raw/",
      "type": "n8n-nodes-base.writeBinaryFile",
      "parameters": {
        "fileName": "=/app/maya-backend/docs/raw/{{$json.body.filename}}",
        "dataPropertyName": "data"
      },
      "position": [640, 200]
    },
    {
      "name": "Call Knowledge MCP — Ingest",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8001/tools/call",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "credentialName": "Maya API",
        "jsonParameters": true,
        "bodyParameters": {
          "parameters": [{
            "name": "body",
            "value": "={\"name\":\"ingest_document\",\"arguments\":{\"pdf_path\":\"/app/maya-backend/docs/raw/{{$json.body.filename}}\",\"metadata\":{\"document_type\":\"{{$json.body.document_type}}\",\"language\":\"{{$json.body.language}}\",\"source\":\"{{$json.body.source}}\"}}}"
          }]
        }
      },
      "position": [860, 200]
    },
    {
      "name": "Log to Maya API",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "http://localhost:8000/n8n/health"
      },
      "position": [1080, 200]
    },
    {
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\":\"ingested\",\"file\":\"{{$json.body.filename}}\"}"
      },
      "position": [1300, 200]
    },
    {
      "name": "Respond Wrong Type",
      "type": "n8n-nodes-base.respondToWebhook",
      "parameters": {
        "respondWith": "json",
        "responseCode": "400",
        "responseBody": "{\"error\":\"Only PDF files are accepted\"}"
      },
      "position": [640, 400]
    }
  ],
  "connections": {
    "Webhook — PDF Upload": { "main": [[{ "node": "Validate File Type" }]] },
    "Validate File Type": { "main": [[{ "node": "Save PDF to docs/raw/" }], [{ "node": "Respond Wrong Type" }]] },
    "Save PDF to docs/raw/": { "main": [[{ "node": "Call Knowledge MCP — Ingest" }]] },
    "Call Knowledge MCP — Ingest": { "main": [[{ "node": "Log to Maya API" }]] },
    "Log to Maya API": { "main": [[{ "node": "Respond Success" }]] }
  }
}
