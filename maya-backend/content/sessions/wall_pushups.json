  "title": { "bn": "ওয়াল পুশ-আপ", "en": "Wall Push-ups" },
  "subtitle": { "bn": "৪ মিনিট · উপরের শরীর", "en": "4 min · Upper Body" },
  "duration_sec": 240,
  "allowed_trimesters": [1, 2, 3],
